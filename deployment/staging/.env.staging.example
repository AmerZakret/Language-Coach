# Copy to an ignored .env.staging.local and replace placeholders locally.
# The disposable Mongo URI is fixed in compose.json; this file cannot redirect it.
STAGING_TIMELINE_ID=44444444-4444-4444-8444-444444444444
STAGING_DATA_WRITE_MODE=CLOSED
STAGING_BUILD_ID=phase11b-local
STAGING_BOOTSTRAP=disabled
STAGING_PRONUNCIATION_ENABLED=false
STAGING_JWT_SECRET=CHANGE_ME_WITH_DISTINCT_RANDOM_STAGING_VALUE
STAGING_PRONUNCIATION_SERVICE_TOKEN=CHANGE_ME_WITH_ANOTHER_RANDOM_STAGING_VALUE
# Future AI integration requires a distinct restricted staging provider key.
# STAGING_GEMINI_API_KEY=CHANGE_ME_WITH_RESTRICTED_STAGING_PROVIDER_KEY

# Independent authority: fresh, distinct 64-character lowercase hex secrets (never production).
STAGING_AUTHORITY_ADMIN_PASSWORD=CHANGE_ME_WITH_64_RANDOM_HEX_CHARACTERS
STAGING_AUTHORITY_READER_PASSWORD=CHANGE_ME_WITH_DISTINCT_64_RANDOM_HEX_CHARACTERS
STAGING_AUTHORITY_OPERATOR_PASSWORD=CHANGE_ME_WITH_ANOTHER_64_RANDOM_HEX_VALUE
STAGING_AUTHORITY_GENERATION=1
STAGING_AUTHORITY_OPERATOR_INTENT=disabled
STAGING_AUTHORITY_BOOTSTRAP=disabled

# C2: four distinct synthetic 64-character lowercase hex values; runtime gets only APP.
STAGING_OBJECT_ADMIN_ACCESS_KEY=CHANGE_ME_WITH_64_RANDOM_HEX_CHARACTERS
STAGING_OBJECT_ADMIN_SECRET_KEY=CHANGE_ME_WITH_DISTINCT_64_RANDOM_HEX_CHARACTERS
STAGING_OBJECT_APP_ACCESS_KEY=CHANGE_ME_WITH_ANOTHER_64_RANDOM_HEX_VALUE
STAGING_OBJECT_APP_SECRET_KEY=CHANGE_ME_WITH_FOURTH_64_RANDOM_HEX_VALUE
STAGING_OBJECT_CONFIG_INIT=disabled
STAGING_OBJECT_BOOTSTRAP=disabled
