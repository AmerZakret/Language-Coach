# Development only. Production ignores .env and requires injected configuration.
# See ../PRODUCTION_CONFIGURATION.md; these defaults must not be deployed.
NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://localhost:27017/language_coach?replicaSet=rs0
JWT_SECRET=development-only-change-me
CORS_ORIGINS=http://localhost:5173
# Behind ingress, list only trusted proxy IPs/CIDRs and sanitize forwarded headers.
TRUST_PROXY=false
# Development defaults to ./uploads. Production requires an absolute persistent path.
UPLOAD_ROOT=uploads
AI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
PRONUNCIATION_ENABLED=false
PRONUNCIATION_SERVICE_URL=http://localhost:8001
# Dedicated random credential, identical in backend and Python service. Never JWT_SECRET.
PRONUNCIATION_SERVICE_TOKEN=
# Bounded core checks and total shutdown window (milliseconds).
READINESS_TIMEOUT_MS=5000
READINESS_RECHECK_MS=15000
SHUTDOWN_GRACE_MS=25000
# Total provider deadlines, including response body and any opt-in retry (milliseconds).
PROVIDER_CHAT_TIMEOUT_MS=35000
PROVIDER_WRITING_TIMEOUT_MS=30000
PROVIDER_FLASHCARD_TIMEOUT_MS=15000
PROVIDER_FEEDBACK_TIMEOUT_MS=8000
PROVIDER_PRONUNCIATION_TIMEOUT_MS=45000
# 0 (default) or 1; every actual attempt consumes provider budget.
PROVIDER_MAX_RETRIES=0
