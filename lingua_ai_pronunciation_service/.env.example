# Documentation only: the service does NOT implicitly load .env files.
# Supply values via deployment configuration. Never commit real credentials.
NODE_ENV=production
PRONUNCIATION_SERVICE_TOKEN=
PRONUNCIATION_HOST=127.0.0.1
PRONUNCIATION_PORT=8001
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_CACHE_DIR=/srv/language-coach/whisper-models
WHISPER_ALLOW_DOWNLOAD=false
MODEL_LOAD_TIMEOUT_SECONDS=120
AUDIO_MAX_BYTES=10485760
AUDIO_MAX_DURATION_SECONDS=30
INFERENCE_CONCURRENCY=1
INFERENCE_TIMEOUT_SECONDS=35
SHUTDOWN_TIMEOUT_SECONDS=5
PRONUNCIATION_ALLOW_INSECURE_LOCAL=false
